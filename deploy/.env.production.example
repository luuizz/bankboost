# Copie para /opt/bankboost/.env no Droplet e preencha.

APP_NAME=Bankboost
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show (ou: echo "base64:$(openssl rand -base64 32)")
APP_KEY=
APP_DOMAIN=bankboost.seudominio.com.br
APP_URL=https://bankboost.seudominio.com.br
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_DATABASE=bankboost
DB_USERNAME=bankboost
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
